{
  "name": "fgtclb/typo3-oauth2-server",
  "type": "typo3-cms-extension",
  "description": "OAuth2 server implementation for TYPO3 frontend users",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "FGTCLB GmbH",
      "email": "hello@fgtclb.com"
    }
  ],
  "support": {
    "issues": "https://github.com/fgtclb/typo3-oauth2-server/issues",
    "source": "https://github.com/fgtclb/typo3-oauth2-server",
    "email": "hello@fgtclb.com"
  },
  "homepage": "https://www.fgtclb.com/",
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "league/oauth2-server": "^9.3.0",
    "psr/http-server-middleware": "^1.0",
    "typo3/cms-core": "^12.4",
    "typo3/cms-frontend": "^12.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "league/oauth2-client": "^2.9.1",
    "phpstan/phpstan": "^1.12.34",
    "phpstan/phpstan-phpunit": "^1.4.2",
    "phpunit/phpunit": "^10.5.66",
    "saschaegerer/phpstan-typo3": "^1.10",
    "sbuerk/fixture-packages": "^1.1.4",
    "sbuerk/typo3-site-based-test-trait": "^1.0.2",
    "typo3/testing-framework": "^8.3.3"
  },
  "autoload": {
    "psr-4": {
      "FGTCLB\\OAuth2Server\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FGTCLB\\OAuth2Server\\Tests\\": "Tests"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "sbuerk/fixture-packages": true
    },
    "bin-dir": ".Build/bin",
    "vendor-dir": ".Build/vendor",
    "audit": {
      "block-insecure": false,
      "block-abandoned": false
    }
  },
  "repositories": {
    "test-ext": {
      "type": "path",
      "url": "./Tests/Functional/Extensions/*"
    }
  },
  "extra": {
    "typo3/cms": {
      "app-dir": ".Build",
      "web-dir": ".Build/Web",
      "extension-key": "oauth2_server",
      "version": "3.0.0-dev"
    },
    "branch-alias": {
      "dev-main": "3.0.x-dev"
    },
    "sbuerk/fixture-packages": {
      "paths": {
        "Tests/Functional/Extensions/*": ["autoload"]
      }
    }
  }
}
